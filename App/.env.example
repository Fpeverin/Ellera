# Copia questo file in ".env" (stesso posto) e incolla i due valori presi da
# Supabase -> Project Settings -> API. Non sono credenziali segrete (la
# chiave "anon" e' pensata per stare nel client), ma il file ".env" resta
# comunque escluso da git per evitare di legare per sbaglio i sorgenti a un
# progetto Supabase specifico.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
